diff --git a/src/platform/win32_compat.c b/src/platform/win32_compat.c
index 0bc888d..1395399 100644
--- a/src/platform/win32_compat.c
+++ b/src/platform/win32_compat.c
@@ -35,7 +35,7 @@
 #include <sys/sysctl.h>
 #include <sys/stat.h>
 #include <mach/mach.h>
-#include <mach/mach_vm.h>
+#include "mach_vm_compat.h"
 #include <mach/thread_switch.h>
 #include <pthread/qos.h>
 #else
@@ -2764,7 +2764,16 @@ static int anon_map_fd(const char *name)
     const char *base = name ? name : "xbox_map";
     snprintf(shm_name, sizeof(shm_name), "/%.12s_%d_%ld", base, (int)getpid(), (long)seq);
     int fd = shm_open(shm_name, O_CREAT | O_RDWR | O_EXCL, 0600);
-    if (fd >= 0) shm_unlink(shm_name);
+    if (fd >= 0) { shm_unlink(shm_name); return fd; }
+    /* iOS: the app sandbox refuses POSIX shared memory; an unlinked file in
+     * the app's own temporary folder maps the same way. */
+    {
+        const char *tmp = getenv("TMPDIR");
+        char path[1024];
+        snprintf(path, sizeof(path), "%s/%s_XXXXXX", tmp && *tmp ? tmp : "/tmp", shm_name + 1);
+        fd = mkstemp(path);
+        if (fd >= 0) unlink(path);
+    }
     return fd;
 #else
     return memfd_create(name ? name : "xbox_map", 0);
