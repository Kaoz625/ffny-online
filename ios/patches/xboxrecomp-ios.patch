diff --git a/src/platform/mach_vm_compat.h b/src/platform/mach_vm_compat.h
new file mode 100644
index 0000000..c16bcf5
--- /dev/null
+++ b/src/platform/mach_vm_compat.h
@@ -0,0 +1,22 @@
+/* <mach/mach_vm.h> is "unsupported" in the iOS SDK, but the same calls exist there as the
+ * vm_* routines of <mach/vm_map.h> (64-bit wide on arm64). blz/ios (Kaoz625). */
+#pragma once
+#include <TargetConditionals.h>
+#if TARGET_OS_IOS || TARGET_OS_TV
+#include <mach/mach.h>
+#include <mach/vm_map.h>
+static inline kern_return_t mach_vm_map(vm_map_t t, mach_vm_address_t *a, mach_vm_size_t s, mach_vm_offset_t m,
+    int f, mem_entry_name_port_t o, memory_object_offset_t off, boolean_t c, vm_prot_t cur, vm_prot_t max, vm_inherit_t i)
+{ vm_address_t v = (vm_address_t)*a; kern_return_t r = vm_map(t, &v, (vm_size_t)s, (vm_address_t)m, f, o, (vm_offset_t)off, c, cur, max, i); *a = v; return r; }
+static inline kern_return_t mach_vm_remap(vm_map_t t, mach_vm_address_t *a, mach_vm_size_t s, mach_vm_offset_t m,
+    int f, vm_map_t src, mach_vm_address_t sa, boolean_t c, vm_prot_t *cur, vm_prot_t *max, vm_inherit_t i)
+{ vm_address_t v = (vm_address_t)*a; kern_return_t r = vm_remap(t, &v, (vm_size_t)s, (vm_address_t)m, f, src, (vm_address_t)sa, c, cur, max, i); *a = v; return r; }
+static inline kern_return_t mach_vm_read_overwrite(vm_map_t t, mach_vm_address_t a, mach_vm_size_t s,
+    mach_vm_address_t d, mach_vm_size_t *out)
+{ vm_size_t n = 0; kern_return_t r = vm_read_overwrite(t, (vm_address_t)a, (vm_size_t)s, (vm_address_t)d, &n); if (out) *out = n; return r; }
+static inline kern_return_t mach_vm_region(vm_map_t t, mach_vm_address_t *a, mach_vm_size_t *s, vm_region_flavor_t f,
+    vm_region_info_t info, mach_msg_type_number_t *cnt, mach_port_t *obj)
+{ vm_address_t v = (vm_address_t)*a; vm_size_t z = 0; kern_return_t r = vm_region_64(t, &v, &z, f, info, cnt, obj); *a = v; *s = z; return r; }
+#else
+#include <mach/mach_vm.h>
+#endif
